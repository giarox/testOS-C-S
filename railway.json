{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "image": "unclecode/crawl4ai:latest",
  "env": {
    "PORT": {
      "default": "11235",
      "description": "Port for Crawl4AI API"
    }
  }
}
